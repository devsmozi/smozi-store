{% comment %}
  SMOZI RECENT SALES NOTIFICATION TOAST
  Discreet floating social proof notification in the bottom corner.
{% endcomment %}

<div class="smozi-sales-toast" id="SmoziSalesToast" role="status" aria-live="polite">
  <button type="button" class="smozi-toast-close" aria-label="Close notification">&times;</button>
  <div class="smozi-author-avatar smozi-toast-thumb" style="width:40px; height:40px; font-size:16px;">
    🛍️
  </div>
  <div class="smozi-toast-info">
    <div class="smozi-toast-buyer">
      <strong class="smozi-toast-buyer-name">Sarah B.</strong> <span class="smozi-toast-buyer-city">from Austin, TX</span>
    </div>
    <div class="smozi-toast-item">
      Purchased <span class="smozi-toast-item-title">Smozi Premium Edition</span>
    </div>
    <div class="smozi-toast-meta">
      <span class="smozi-toast-time">3 minutes ago</span>
      <span>•</span>
      <span class="smozi-badge-verified" style="padding: 1px 6px; font-size: 0.65rem;">Verified</span>
    </div>
  </div>
</div>

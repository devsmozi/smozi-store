{% comment %}
  SMOZI PRODUCT PAGE TRUST ARCHITECTURE
  Rendered immediately below the Add to Cart / Buy buttons to eliminate friction and induce conversion.
{% endcomment %}

<div class="smozi-product-trust-wrapper">
  <!-- Live Viewer & Urgency Indicator -->
  <div class="smozi-live-stat-box">
    <div class="smozi-live-stat-item">
      <span class="smozi-pulse-dot"></span>
      <span><strong class="smozi-viewer-count">28</strong> shoppers currently viewing this item</span>
    </div>
    <div class="smozi-urgency-stock">
      <svg style="width: 14px; height: 14px; fill: currentColor;" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
      <span>Limited Stock Available</span>
    </div>
  </div>

  <!-- Delivery Window Estimator -->
  <div class="smozi-delivery-box">
    <div class="smozi-delivery-icon">
      <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H1v13h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
    </div>
    <div class="smozi-delivery-text">
      <strong>Fast & Insured Delivery:</strong> Estimated arrival between <span class="smozi-delivery-date">Calculating...</span> when ordered today. Includes end-to-end tracking.
    </div>
  </div>

  <!-- Risk-Free Guarantee Seal -->
  <div class="smozi-guarantee-seal-box">
    <div class="smozi-guarantee-badge-icon">
      <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
    </div>
    <div class="smozi-guarantee-content">
      <h4>30-Day 100% Risk-Free Guarantee</h4>
      <p>Love your Smozi order or get your money back. No hassle, no questions asked.</p>
    </div>
  </div>

  <!-- Certified Payment Security & Gateway Badges -->
  <div class="smozi-payment-trust-bar">
    <div class="smozi-payment-trust-heading">
      <span>Guaranteed Safe & Secure Checkout</span>
      <span class="smozi-ssl-secure">
        <svg style="width: 14px; height: 14px; fill: currentColor;" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        256-Bit SSL Encryption
      </span>
    </div>
    <div class="smozi-payment-icons-row">
      <span class="smozi-payment-pill">💳 Visa</span>
      <span class="smozi-payment-pill">💳 Mastercard</span>
      <span class="smozi-payment-pill">💳 American Express</span>
      <span class="smozi-payment-pill"> Apple Pay</span>
      <span class="smozi-payment-pill">G Pay</span>
      <span class="smozi-payment-pill">PayPal</span>
      <span class="smozi-payment-pill">Shop Pay</span>
      <span class="smozi-payment-pill">💵 Cash on Delivery</span>
    </div>
  </div>
</div>

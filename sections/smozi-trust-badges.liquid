{% comment %}
  SMOZI TRUST BADGES SECTION
  Displays high-impact trust signals, guarantees, and security certifications.
{% endcomment %}

<div class="smozi-trust-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div style="text-align: center; margin-bottom: 2.5rem;">
        {% if section.settings.subheading != blank %}
          <span class="smozi-badge-verified" style="margin-bottom: 0.75rem;">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 style="font-size: 2rem; font-weight: 800; margin: 0; color: var(--smozi-trust-slate-900);">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="smozi-trust-grid">
      {% for block in section.blocks %}
        <div class="smozi-trust-card" {{ block.shopify_attributes }}>
          <div class="smozi-trust-card-icon">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H1v13h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
              {% when 'guarantee' %}
                <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              {% when 'lock' %}
                <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>
              {% when 'star' %}
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            {% endcase %}
          </div>
          <h3 class="smozi-trust-card-title">{{ block.settings.title }}</h3>
          <p class="smozi-trust-card-desc">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Smozi Trust Badges",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Badge",
      "default": "Shop With Confidence"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Over 50,000+ Customers Trust Smozi"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Free Fast Shipping" },
            { "value": "guarantee", "label": "Money Back Guarantee" },
            { "value": "lock", "label": "SSL Secure Checkout" },
            { "value": "support", "label": "24/7 Dedicated Support" },
            { "value": "star", "label": "5-Star Top Quality" }
          ],
          "default": "guarantee"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-Day Money Back Guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Not 100% in love? Return it within 30 days for a prompt, hassle-free refund."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smozi Trust Badges",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "shipping",
            "title": "Free Express Shipping",
            "text": "Fast, insured delivery with tracking number sent straight to your email."
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "guarantee",
            "title": "30-Day Risk-Free Trial",
            "text": "100% money-back guarantee if you are not totally thrilled with your purchase."
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "lock",
            "title": "Bank-Grade SSL Security",
            "text": "256-bit encrypted checkout keeping all your personal and payment data safe."
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "support",
            "title": "24/7 Priority Support",
            "text": "Dedicated customer concierge team ready to assist you day and night."
          }
        }
      ]
    }
  ]
}
{% endschema %}

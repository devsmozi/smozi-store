{% comment %}
  SMOZI TRUST & RISK-REVERSAL FAQ SECTION
  Addresses customer hesitation, returns, shipping, and guarantees.
{% endcomment %}

<div class="smozi-faq-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width smozi-faq-container">
    <div class="smozi-faq-header">
      {% if section.settings.subheading != blank %}
        <div class="smozi-faq-subtitle">{{ section.settings.subheading }}</div>
      {% endif %}
      <h2 class="smozi-faq-title">{{ section.settings.title }}</h2>
      {% if section.settings.description != blank %}
        <p style="color: var(--smozi-trust-slate-600); margin-top: 0.5rem; font-size: 1.05rem;">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="smozi-faq-list">
      {% for block in section.blocks %}
        <div class="smozi-faq-item{% if forloop.first %} smozi-open{% endif %}" {{ block.shopify_attributes }}>
          <button type="button" class="smozi-faq-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span>{{ block.settings.question }}</span>
            <svg class="smozi-faq-icon-chevron" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
          </button>
          <div class="smozi-faq-content">
            <p>{{ block.settings.answer }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Smozi Trust FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Everything you need to know about our products, guarantees, and fast delivery."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does the 30-Day Money Back Guarantee work?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We want you to shop with complete peace of mind. If you are not 100% satisfied with your order for any reason, simply email support within 30 days of receiving your item, and we will issue a full refund."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smozi Trust FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take and how do I track my order?",
            "answer": "Orders are processed within 24 hours. Domestic express shipping usually takes 2–4 business days, and international orders arrive in 5–8 business days. You will receive an automated tracking link as soon as your package leaves our facility."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your 30-Day Risk-Free Return Policy?",
            "answer": "We stand behind the quality of our products 100%. If you are not totally delighted, just reach out to us at support@smozi.com within 30 days of delivery. We will provide a hassle-free return label and a prompt, full refund."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is my payment information safe and encrypted?",
            "answer": "Yes, absolutely. We use bank-grade 256-bit SSL encryption to process all transactions. Your card details are never stored on our servers and are processed directly through certified payment gateways (Shopify Payments, PayPal, Apple Pay, Visa, Mastercard)."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I modify or cancel my order after placing it?",
            "answer": "Yes! Because our fulfillment center processes orders rapidly, please email support@smozi.com within 1–2 hours of placing your order if you need to adjust your shipping address or items."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I get in touch with customer support?",
            "answer": "Our customer support team is available 24/7. You can reach us via our Contact Us page or directly at support@smozi.com. We pride ourselves on fast responses, typically under 2 hours!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
